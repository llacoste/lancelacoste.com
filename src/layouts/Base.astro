---
import '../styles/global.css';
import Icon from '../components/Icon.astro';
interface Props { title?: string; description?: string; }
const { title = 'Lance Lacoste', description = 'Lance Lacoste designs reliable platforms that help engineering teams ship faster and operate with confidence.' } = Astro.props;
const path = Astro.url.pathname;
const nav = [
  { href: '/', label: 'Home' },
  { href: '/#work', label: 'Work' },
  { href: '/resume', label: 'Resume' },
  { href: '/#contact', label: 'Contact' },
];
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>document.documentElement.classList.add('js');</script>
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/png" href="/icon.png" />
    <link rel="canonical" href={new URL(path, Astro.site)} />
  </head>
  <body class={path === '/' ? 'home' : undefined}>
    <header class="site-header">
      <div class="site-header-inner">
        <a class="brand" href="/">Lance Lacoste</a>
        <nav class="site-nav" aria-label="Primary">
          {nav.map((item) => (
            <a href={item.href} class={isActive(item.href) ? 'active' : ''} aria-current={isActive(item.href) ? 'page' : undefined}>{item.label}</a>
          ))}
        </nav>
      </div>
    </header>
    <main>
      <slot />
    </main>
    <dialog id="contact-dialog" class="modal" aria-labelledby="contact-dialog-title">
      <button class="modal-close" type="button" data-close aria-label="Close"><Icon name="x" size={18} /></button>
      <h2 id="contact-dialog-title">Get in touch</h2>
      <p>Always glad to talk platform architecture, reliability, and developer experience.</p>
      <div class="cta-row">
        <a class="btn primary" href="mailto:lance.lacoste@proton.me"><Icon name="mail" />Email me</a>
        <a class="btn" href="https://www.linkedin.com/in/lancelacoste" rel="me noopener" target="_blank"><Icon name="linkedin" />LinkedIn</a>
        <a class="btn" href="https://github.com/llacoste" rel="me noopener" target="_blank"><Icon name="github" />GitHub</a>
      </div>
    </dialog>
    <script is:inline>
      (function () {
        if (document.body.classList.contains('home')) {
          var mark = document.querySelector('.hero h1');
          if (mark && 'IntersectionObserver' in window) {
            new IntersectionObserver(function (entries) {
              document.body.classList.toggle('scrolled', !entries[0].isIntersecting);
            }, { rootMargin: '-64px 0px 0px 0px', threshold: 0 }).observe(mark);
          }
        }
        var dialog = document.getElementById('contact-dialog');
        if (!dialog || typeof dialog.showModal !== 'function') return;
        document.querySelectorAll('a[href="/#contact"]').forEach(function (el) {
          el.addEventListener('click', function (e) {
            e.preventDefault();
            dialog.showModal();
          });
        });
        dialog.addEventListener('click', function (e) {
          if (e.target === dialog) dialog.close();
        });
        dialog.querySelectorAll('[data-close]').forEach(function (b) {
          b.addEventListener('click', function () { dialog.close(); });
        });
      })();
    </script>
  </body>
</html>
