---
import '../styles/global.css';
interface Props { title?: string; description?: string; }
const { title = 'Lance Lacoste', description = 'Lance Lacoste designs reliable platforms that help engineering teams ship faster and operate with confidence.' } = Astro.props;
const path = Astro.url.pathname;
const nav = [
  { href: '/', label: 'Home' },
  { href: '/projects', label: 'Projects' },
  { href: '/blog', label: 'Blog' },
  { href: '/resume', label: 'Resume' },
];
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/png" href="/icon.png" />
    <link rel="canonical" href={new URL(path, Astro.site)} />
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href="/">Lance Lacoste</a>
      <nav class="site-nav" aria-label="Primary">
        {nav.map((item) => (
          <a href={item.href} class={isActive(item.href) ? 'active' : ''} aria-current={isActive(item.href) ? 'page' : undefined}>{item.label}</a>
        ))}
      </nav>
    </header>
    <main>
      <slot />
    </main>
  </body>
</html>
