---
import Base from '../layouts/Base.astro';
const pdf = 'https://resume.lancelacoste.com/resume.pdf';
---
<Base title="Lance Lacoste — Resume" description="Resume of Lance Lacoste — Principal Platform Engineer and Systems Architect.">
  <section class="resume">
    <a class="btn primary resume-download" href={pdf} download>Download PDF</a>
    <object class="resume-viewer" data={pdf} type="application/pdf">
      <iframe class="resume-viewer" src={pdf} title="Lance Lacoste resume"></iframe>
      <p>Your browser can't display the PDF inline. <a href={pdf}>Open the resume PDF</a>.</p>
    </object>
  </section>
</Base>
